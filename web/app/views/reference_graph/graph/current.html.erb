<% content_for :title, "Graph: Current — Unpossible" %>

<h1>Current Beat</h1>

<% if @current_beat %>
  <div class="card">
    <div class="card-header">
      <span class="badge badge-running"><%= @current_beat['status'] %></span>
      <strong><%= @current_beat['id'] %></strong>
    </div>
    <div><%= @current_beat['label'] %></div>
  </div>

  <% if @ancestors.any? %>
    <h2>Ancestor Chain</h2>
    <% @ancestors.each do |node| %>
      <div class="card">
        <div class="card-header">
          <span class="meta"><%= node['type'] %></span>
          <span class="meta"><%= node['id'] %></span>
        </div>
        <div><%= node['label'] %></div>
        <% if node['path'].present? %>
          <div class="meta" style="margin-top:4px;"><%= node['path'] %></div>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% else %>
  <p class="meta">No in-progress beat found.</p>
  <p class="meta" style="margin-top:8px;">
    <%= link_to "View open beats →", graph_open_path %>
  </p>
<% end %>
